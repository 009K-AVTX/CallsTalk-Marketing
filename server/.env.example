# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
TELEGRAM_THREAD_ID=
TELEGRAM_TOPIC_PER_CHAT=false
# Set to false on a local copy that uses the live bot token, so it doesn't take the live server's updates.
TELEGRAM_POLLING=true

# Email notifications (leave EMAIL_TO empty to turn off)
EMAIL_TO=support@callstalk.com
EMAIL_FROM=CallsTalk Chat <support@callstalk.com>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@callstalk.com
SMTP_PASS=
PUBLIC_URL=https://chat.callstalk.com
REPLY_LINK_DAYS=30

# Database (PostgreSQL 18, same server as the CRM, separate database)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=callstalk_chat
DB_USER=callstalk_chat
DB_PASSWORD=

# Server (development: email reply links use localhost:5173)
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=https://callstalk.com,https://www.callstalk.com
CHAT_TIMEOUT_HOURS=24

# Customer portal (portal.callstalk.com). Setup links in emails open it; SMTP above sends them.
# In development (NODE_ENV=development) links open DEV_PORTAL_URL, default http://localhost:5180.
VITE_PORTAL_APP_URL=https://portal.callstalk.com
PORTAL_INVITE_DAYS=7
PORTAL_SESSION_DAYS=30

# Customer payments: USDT on TRON (TRC-20) through Well Wallet (docs.wellwallet.io). Leave the token empty
# to keep online payment off. The API key needs the Wallets and Transactions APIs switched on, and this
# server's IP on Well Wallet's whitelist. Webhook URL to set in their bot:
#   https://portal.callstalk.com/api/payments/webhook?key=<WELLWALLET_WEBHOOK_KEY>
WELLWALLET_API_URL=https://tag.alfa-bot.com/api/prod/v1
WELLWALLET_API_TOKEN=
WELLWALLET_WEBHOOK_KEY=
# accounting = exchange wallet (recommended, as the TOPUP bot uses), user = private wallet
WELLWALLET_WALLET_TYPE=accounting
WELLWALLET_POLL_SECONDS=120

# Optional: also serve the website and AI assistant
SERVE_SITE=false
SITE_DIR=../dist
GROQ_API_KEY=
