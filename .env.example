# Base URL of the chat server in server/ (it serves /api/support/...).
# Leave empty to hide "Talk to Our Team" in the chat widget.
VITE_SUPPORT_API_URL=https://chat.callstalk.com/api
# Customer portal (portal/, portal.callstalk.com): its API on the server in server/. On the VPS the portal
# is built with VITE_PORTAL_API_URL=/api (same address, through nginx). Defaults to VITE_SUPPORT_API_URL.
# With neither set, `npm run portal` shows sample figures and any login works; `npm run portal:live`
# uses /api on a local server instead.
VITE_PORTAL_API_URL=
# Where the website's Log In goes, and the website address the portal links back to.
VITE_PORTAL_APP_URL=https://portal.callstalk.com
VITE_SITE_URL=https://callstalk.com

# Server-side only (Vercel environment variable): key for the AI assistant in api/chat.js.
GROQ_API_KEY=

# Request-access form -> Telegram (server only, never prefixed with VITE_)
TELEGRAM_BOT_TOKEN=
# One group, or several separated by commas
TELEGRAM_CHAT_ID=
# Optional: post into a forum topic (of the first group)
TELEGRAM_THREAD_ID=
# Request-access form -> review email via resend.com
RESEND_API_KEY=
ACCESS_REQUEST_EMAIL_TO=
# A sender on a domain verified in Resend, e.g. CallsTalk <requests@yourdomain.com>
ACCESS_REQUEST_EMAIL_FROM=
